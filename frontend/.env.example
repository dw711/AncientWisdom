# Copy to .env.local and fill in. Never commit real keys. None of these are
# exposed to the browser (no NEXT_PUBLIC_ prefix).

# "demo" (default): prewritten sample analyses for the example dilemmas, no provider calls.
# "live": real Jev ranking and LLM synthesis via OpenRouter. Provider failures return partial results, never samples.
APP_MODE=demo

# --- OpenRouter (bills both Jev and the LLM) ---
# One key for everything: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Jev via OpenRouter's System One API (same request/response shape as TypeSafe's).
# Pin a versioned ID for reproducible ratings; ~typesafe/jev-latest tracks the newest release.
JEV_MODEL=typesafe/jev-1.14
# JEV_API_URL=https://openrouter.ai/api/v1/systemone
# JEV_BATCH_SIZE=3
# JEV_CONCURRENCY=2
# JEV_TIMEOUT_MS=20000

# LLM via OpenRouter chat completions with strict JSON-schema output
# (profile extraction and written comparisons).
# Any OpenRouter model with structured_outputs support, e.g. anthropic/claude-opus-5.5 for higher quality at ~8x the cost.
LLM_MODEL=google/gemini-3.8-flash
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_EXTRACTION_EFFORT=low
# LLM_SYNTHESIS_EFFORT=low
# LLM_TIMEOUT_MS=120000
# LLM_PROFILE_TIMEOUT_MS=45000

# --- Pipeline ---
# PIPELINE_DEADLINE_MS=180000
# Application heuristic weights, renormalised to sum to 1.
# ANALOGY_WEIGHTS=structural=0.45,incentives=0.25,constraints=0.20,time=0.10
# MIN_ANALOGY_FIT=45
# CRITICAL_MISMATCH_THRESHOLD=0.6
# STRUCTURAL_FLOOR=0.4
# CHALLENGE_THRESHOLD=0.6
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=300000

# --- Corpus storage ---
# Team PostgreSQL corpus, used in live mode when set (read-only sessions).
# DATABASE_URL=postgresql://user:password@host:port/db?sslmode=verify-full
# CORPUS_VERSION=2026-10-24.1
# CORPUS_SOURCE=json   # force the JSON seed even when DATABASE_URL is set
# CORPUS_CACHE_SECONDS=300
# Versioned JSON corpus used by JsonCaseRepository: a folder name inside data/corpus/, or an absolute path.
# CORPUS_DIR=seed-v0.1.0
